{
  "action": {
    "default_icon": "src/assets/logo/favicon-128.png",
    "default_popup": "src/pages/popup/index.html"
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/index.ts-loader-CHC_CSfL.js",
        "injects/fallback.js"
      ],
      "css": [
        "injects/fallback.css"
      ],
      "matches": [
        "https://www.facebook.com/*",
        "https://web.facebook.com/*"
      ],
      "run_at": "document_end"
    }
  ],
  "default_locale": "en",
  "description": "Open-source ad blocker for Facebook: remove Reels, sponsored posts, suggested content, and clutter.",
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://web.facebook.com/*"
  ],
  "icons": {
    "128": "src/assets/logo/favicon-128.png",
    "16": "src/assets/logo/favicon-16.png",
    "19": "src/assets/logo/favicon-19.png",
    "32": "src/assets/logo/favicon-32.png",
    "38": "src/assets/logo/favicon-38.png",
    "48": "src/assets/logo/favicon-48.png"
  },
  "incognito": "not_allowed",
  "manifest_version": 3,
  "minimum_chrome_version": "103",
  "name": "FB AdBlocker & Clean Feed (Open Source)",
  "options_page": "src/pages/options/index.html",
  "permissions": [
    "scripting",
    "storage",
    "declarativeNetRequest"
  ],
  "version": "2.10.1",
  "version_name": "2.10.1-opensource",
  "web_accessible_resources": [
    {
      "matches": [
        "https://web.facebook.com/*",
        "https://www.facebook.com/*"
      ],
      "resources": [
        "*",
        "assets/const-VfW2e5AY.js",
        "assets/index.ts-BJHj831H.js"
      ],
      "use_dynamic_url": false
    }
  ]
}